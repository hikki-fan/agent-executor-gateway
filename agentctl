#!/usr/bin/env python3
"""
agentctl — CLI Management, Task Orchestration, and Worktree Tool for Agent Executor Gateway.

Supported commands per Goal Prompt Sections 33, 34, 39, 48, 49, 50:
- agentctl task validate TASK.json
- agentctl task verify TASK.json [--repo PATH] [--log-dir DIR] [--timeout SEC]
- agentctl task route TASK.json [--override EXECUTOR] [--json]
- agentctl task plan TASK.json [--override EXECUTOR] [--json]
- agentctl task ready TASK1.json [TASK2.json ...] [--json]
- agentctl task graph TASK1.json [TASK2.json ...] [--json]
- agentctl worktree create TASK.json [--root DIR] [--json]
- agentctl worktree list [--root DIR] [--repo PATH] [--json]
- agentctl worktree cleanup <task_id | path> [--repo PATH] [--root DIR] [--force]
- agentctl executors
- agentctl health
- agentctl invoke <executor> --cwd <CWD> --prompt <PROMPT> [--session-id <ID>]
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import sys
import time

# Ensure repository root is on sys.path
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from orchestration.task import Task, load_and_validate_task, validate_task_dict
from orchestration.verifier import verify_task
from orchestration.report import generate_completion_report, record_task_metrics
from orchestration.router import route_task, RouteDecision
from orchestration.worktree import WorktreeInfo, WorktreeManager
from orchestration.dag import TaskDAG, TaskNode


def cmd_task_validate(args: argparse.Namespace) -> int:
    """Validate task JSON file and print report."""
    filepath = args.task_file
    if not os.path.exists(filepath):
        print(f"Error: Task file not found: '{filepath}'", file=sys.stderr)
        return 1

    task, errors = load_and_validate_task(filepath)
    if errors or task is None:
        print(f"Task validation FAILED for '{filepath}':", file=sys.stderr)
        for err in errors:
            print(f"  - {err}", file=sys.stderr)
        return 1

    if args.json:
        print(task.to_json(indent=2))
    else:
        print(f"Task validation PASSED: '{filepath}'")
        print(f"  Task ID:        {task.task_id}")
        print(f"  Goal:           {task.goal}")
        print(f"  Executor:       {task.execution.executor}")
        print(f"  Complexity:     {task.classification.complexity}")
        print(f"  Risk:           {task.classification.risk}")
        print(f"  Repository:     {task.repository.path} (base_commit={task.repository.base_commit})")
        print(f"  Scope:          allowed={len(task.scope.allowed_paths)}, forbidden={len(task.scope.forbidden_paths)}")
        print(f"  Verification:   {len(task.verification.commands)} commands declared")
        if task.depends_on:
            print(f"  Depends On:     {', '.join(task.depends_on)}")
    return 0


def cmd_task_verify(args: argparse.Namespace) -> int:
    """Run verification pipeline (commands + scope check) for a task."""
    filepath = args.task_file
    if not os.path.exists(filepath):
        print(f"Error: Task file not found: '{filepath}'", file=sys.stderr)
        return 1

    task, errors = load_and_validate_task(filepath)
    if errors or task is None:
        print(f"Error: Cannot verify invalid task file '{filepath}':", file=sys.stderr)
        for err in errors:
            print(f"  - {err}", file=sys.stderr)
        return 1

    start_time = time.monotonic()
    try:
        verif_result = verify_task(
            task=task,
            repo_path=args.repo,
            command_timeout_sec=args.timeout,
            log_dir=args.log_dir,
            skip_scope=args.skip_scope,
        )
    except Exception as e:
        print(f"Error during verification execution: {e}", file=sys.stderr)
        return 1

    duration_ms = int((time.monotonic() - start_time) * 1000)

    # Generate completion report
    report = generate_completion_report(
        task=task,
        verification=verif_result,
        executor=task.execution.executor,
        session_id=args.session_id,
        repo_path=args.repo,
    )

    # Append metric to .agent/metrics.jsonl
    try:
        metric_file = record_task_metrics(
            task=task,
            verification=verif_result,
            duration_ms=duration_ms,
            attempts=1,
            fallback_used=False,
            review_pass=True,
            repo_path=args.repo,
            metrics_file_path=args.metrics_file,
        )
    except Exception as e:
        print(f"Warning: Failed to record metrics: {e}", file=sys.stderr)
        metric_file = ""

    if args.json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
    else:
        print(f"=== Task Verification Report: {task.task_id} ===")
        print(f"Status:       {verif_result.status.upper()}")
        if verif_result.reason:
            print(f"Failure:      {verif_result.reason}")
        print(f"Summary:      {verif_result.summary}")
        print(f"Duration:     {duration_ms}ms")
        print(f"Scope Check:  {'PASSED' if verif_result.scope_result.passed else 'FAILED'}")
        if not verif_result.scope_result.passed:
            print(f"  Scope Violations ({len(verif_result.scope_result.violating_files)}):")
            for vf in verif_result.scope_result.violating_files:
                print(f"    - {vf}")
        print(f"Commands ({len(verif_result.command_results)}):")
        for idx, cr in enumerate(verif_result.command_results, start=1):
            print(f"  [{idx}] {cr.command} -> {cr.status.upper()} (exit {cr.exit_code}, {cr.duration_ms}ms)")
            if cr.log_path:
                print(f"      Log: {cr.log_path}")
        if metric_file:
            print(f"Metrics:      Appended to {metric_file}")

    return 0 if verif_result.status == "passed" else 1


def cmd_task_route(args: argparse.Namespace) -> int:
    """Run rule-based routing on a Task and output routing decision."""
    filepath = args.task_file
    if not os.path.exists(filepath):
        print(f"Error: Task file not found: '{filepath}'", file=sys.stderr)
        return 1

    task, errors = load_and_validate_task(filepath)
    if errors or task is None:
        print(f"Error: Cannot route invalid task file '{filepath}':", file=sys.stderr)
        for err in errors:
            print(f"  - {err}", file=sys.stderr)
        return 1

    decision = route_task(task, executor_override=args.override)

    if args.json:
        print(json.dumps(decision.to_dict(), indent=2, ensure_ascii=False))
    else:
        print(f"=== Task Routing Decision: {task.task_id} ===")
        print(f"Status:       {decision.status.upper()}")
        print(f"Executor:     {decision.executor or '(None)'}")
        print(f"Rule:         {decision.rule}")
        print(f"Complexity:   {decision.complexity} (risk={decision.risk}, type={decision.task_type})")
        print(f"Review Req:   {decision.requires_human_review}")
        print(f"Reason:       {decision.reason}")

    return 0 if decision.status == "routed" else 1


def cmd_task_plan(args: argparse.Namespace) -> int:
    """Compute and display the end-to-end execution and escalation plan for a Task."""
    filepath = args.task_file
    if not os.path.exists(filepath):
        print(f"Error: Task file not found: '{filepath}'", file=sys.stderr)
        return 1

    task, errors = load_and_validate_task(filepath)
    if errors or task is None:
        print(f"Error: Cannot plan invalid task file '{filepath}':", file=sys.stderr)
        for err in errors:
            print(f"  - {err}", file=sys.stderr)
        return 1

    decision = route_task(task, executor_override=args.override)

    primary_executor = decision.executor or task.execution.executor
    fallback_executor = task.execution.fallback_executor or ("grok" if primary_executor == "agy" else "agy")

    plan = {
        "task_id": task.task_id,
        "goal": task.goal,
        "classification": {
            "complexity": task.classification.complexity,
            "risk": task.classification.risk,
            "type": task.classification.type,
        },
        "routing": {
            "decision": decision.to_dict(),
            "primary_executor": primary_executor,
            "fallback_executor": fallback_executor,
        },
        "escalation_policy": {
            "max_same_executor_attempts": task.execution.max_same_executor_attempts,
            "max_executor_switches": task.execution.max_executor_switches,
            "max_replans": 1,
            "escalation_chain": [
                f"{primary_executor} (attempt 1)",
                f"{primary_executor} self-repair (attempt 2)",
                f"{fallback_executor} escalation (attempt 1)",
                f"{fallback_executor} self-repair (attempt 2)",
                "REPLAN_REQUIRED (Codex intervention)",
            ],
        },
        "scope": {
            "allowed_paths": task.scope.allowed_paths,
            "forbidden_paths": task.scope.forbidden_paths,
        },
        "verification_commands": task.verification.commands,
    }

    if args.json:
        print(json.dumps(plan, indent=2, ensure_ascii=False))
    else:
        print(f"=== Task Execution Plan: {task.task_id} ===")
        print(f"Goal:                 {task.goal}")
        print(f"Classification:       {task.classification.complexity} complexity | {task.classification.risk} risk | {task.classification.type}")
        print(f"Initial Executor:     {primary_executor} (Rule: {decision.rule})")
        print(f"Fallback Executor:    {fallback_executor}")
        print(f"Attempts Budget:      {task.execution.max_same_executor_attempts} same-executor attempts")
        print(f"Switches Budget:      {task.execution.max_executor_switches} switch(es)")
        print(f"Escalation Chain:     {' -> '.join(plan['escalation_policy']['escalation_chain'])}")
        print(f"Verification Cmds ({len(task.verification.commands)}):")
        for cmd in task.verification.commands:
            print(f"  - `{cmd}`")

    return 0 if decision.status == "routed" else 1


def _collect_tasks(paths: list[str]) -> tuple[list[Task], list[str]]:
    """Collect and validate tasks from files or directories without duplicates."""
    tasks: list[Task] = []
    errors: list[str] = []
    seen_files: set[str] = set()
    seen_ids: set[str] = set()

    expanded_files: list[str] = []
    for p in paths:
        if os.path.isdir(p):
            for pattern in ("*.json",):
                expanded_files.extend(sorted(glob.glob(os.path.join(p, pattern))))
        elif os.path.isfile(p):
            expanded_files.append(p)
        else:
            errors.append(f"Task path not found: '{p}'")

    for f in expanded_files:
        real_f = os.path.realpath(f)
        if real_f in seen_files:
            continue
        seen_files.add(real_f)

        t, errs = load_and_validate_task(f)
        if errs or t is None:
            errors.append(f"Invalid task in '{f}': {'; '.join(errs)}")
        elif t.task_id not in seen_ids:
            seen_ids.add(t.task_id)
            tasks.append(t)

    return tasks, errors


def cmd_task_ready(args: argparse.Namespace) -> int:
    """Evaluate Task DAG and output tasks ready for parallel dispatch."""
    tasks, errors = _collect_tasks(args.task_files)
    if errors:
        for err in errors:
            print(f"Error: {err}", file=sys.stderr)
        return 1

    if not tasks:
        print("Error: No task files provided", file=sys.stderr)
        return 1

    dag = TaskDAG(tasks)
    valid, dag_errors = dag.validate_dag()
    if not valid:
        print(f"DAG validation failed: {'; '.join(dag_errors)}", file=sys.stderr)
        return 1

    ready_nodes = dag.get_ready_tasks()
    if args.json:
        print(json.dumps({"ready_tasks": [n.task.task_id for n in ready_nodes]}, indent=2))
    else:
        print(f"=== Ready Tasks ({len(ready_nodes)}/{len(dag.nodes)}) ===")
        for n in ready_nodes:
            deps_str = f" (depends on: {', '.join(n.task.depends_on)})" if n.task.depends_on else " (no dependencies)"
            print(f"  [READY] {n.task.task_id} -> executor={n.task.execution.executor}{deps_str}")

    return 0


def cmd_task_graph(args: argparse.Namespace) -> int:
    """Display Task DAG dependency graph and state."""
    tasks, errors = _collect_tasks(args.task_files)
    if errors:
        for err in errors:
            print(f"Error: {err}", file=sys.stderr)
        return 1

    if not tasks:
        print("Error: No task files provided", file=sys.stderr)
        return 1

    dag = TaskDAG(tasks)
    valid, dag_errors = dag.validate_dag()
    if not valid:
        print(f"DAG validation failed: {'; '.join(dag_errors)}", file=sys.stderr)
        return 1

    dag.evaluate_readiness()
    if args.json:
        print(json.dumps(dag.to_dict(), indent=2, ensure_ascii=False))
    else:
        print(f"=== Task DAG Graph ({len(dag.nodes)} tasks) ===")
        for tid, node in dag.nodes.items():
            deps = node.task.depends_on
            deps_str = f"depends on [{', '.join(deps)}]" if deps else "root (no dependencies)"
            print(f"  [{node.status}] {tid} ({node.task.execution.executor}, {node.task.classification.complexity}): {deps_str}")
    return 0


def cmd_worktree_create(args: argparse.Namespace) -> int:
    """Create an isolated worktree at base_commit for a Task."""
    filepath = args.task_file
    if not os.path.exists(filepath):
        print(f"Error: Task file not found: '{filepath}'", file=sys.stderr)
        return 1

    task, errors = load_and_validate_task(filepath)
    if errors or task is None:
        print(f"Error: Cannot create worktree for invalid task '{filepath}':", file=sys.stderr)
        for err in errors:
            print(f"  - {err}", file=sys.stderr)
        return 1

    try:
        mgr = WorktreeManager(repo_path=task.repository.path, root_dir=args.root)
        wt_info = mgr.create_worktree(task, executor=args.executor)
        if args.json:
            print(json.dumps(wt_info.to_dict(), indent=2))
        else:
            print(f"Worktree CREATED successfully for {task.task_id}:")
            print(f"  Path:        {wt_info.path}")
            print(f"  Branch:      {wt_info.branch}")
            print(f"  Base Commit: {wt_info.base_commit}")
            print(f"  Executor:    {wt_info.executor}")
        return 0
    except Exception as e:
        print(f"Error creating worktree: {e}", file=sys.stderr)
        return 1


def cmd_worktree_list(args: argparse.Namespace) -> int:
    """List active worktrees under management."""
    repo_path = args.repo or os.getcwd()
    try:
        mgr = WorktreeManager(repo_path=repo_path, root_dir=args.root)
        worktrees = mgr.list_worktrees()
        if args.json:
            print(json.dumps({"worktrees": [w.to_dict() for w in worktrees]}, indent=2))
        else:
            print(f"Active Worktrees ({len(worktrees)}) under '{mgr.root_dir}':")
            for wt in worktrees:
                print(f"  - {wt.task_id} ({wt.executor}): {wt.path} [branch={wt.branch}, HEAD={wt.base_commit[:8]}]")
        return 0
    except Exception as e:
        print(f"Error listing worktrees: {e}", file=sys.stderr)
        return 1


def cmd_worktree_cleanup(args: argparse.Namespace) -> int:
    """Safely remove a worktree and its branch."""
    repo_path = args.repo or os.getcwd()
    try:
        mgr = WorktreeManager(repo_path=repo_path, root_dir=args.root)
        cleaned = mgr.cleanup_worktree(args.target, force=args.force)
        if cleaned:
            print(f"Worktree '{args.target}' safely removed.")
            return 0
        else:
            print(f"Worktree '{args.target}' not found or already cleaned.", file=sys.stderr)
            return 1
    except Exception as e:
        print(f"Error cleaning worktree: {e}", file=sys.stderr)
        return 1


def cmd_executors(args: argparse.Namespace) -> int:
    """List available and registered executors."""
    try:
        from acp_server import executor_registry
        executors = executor_registry.list_executors()
        if args.json:
            print(json.dumps({"executors": executors}, indent=2))
        else:
            print("Registered Executors:")
            for exc in executors:
                status_mark = "✓" if exc.get("available") else "✗"
                sess_mark = "yes" if exc.get("supports_session") else "no"
                print(f"  [{status_mark}] {exc.get('name')}: available={exc.get('available')}, supports_session={sess_mark}")
        return 0
    except Exception as e:
        print(f"Error querying executors: {e}", file=sys.stderr)
        return 1


def cmd_health(args: argparse.Namespace) -> int:
    """Probe server and executors health."""
    try:
        from acp_server import executor_registry
        executors_health = {}
        for name in executor_registry.registered_names():
            adapter = executor_registry.get(name)
            if adapter:
                executors_health[name] = adapter.health()
        health_data = {
            "status": "online",
            "executors": executors_health,
        }
        print(json.dumps(health_data, indent=2))
        return 0
    except Exception as e:
        print(f"Error querying health: {e}", file=sys.stderr)
        return 1


def cmd_invoke(args: argparse.Namespace) -> int:
    """Directly invoke an executor with prompt and options."""
    try:
        from acp_server import executor_registry
        adapter = executor_registry.get(args.executor)
        if not adapter:
            print(f"Error: Executor '{args.executor}' not found", file=sys.stderr)
            return 1

        result = adapter.invoke(
            prompt=args.prompt,
            cwd=args.cwd,
            session_id=args.session_id,
            model=args.model,
            effort=args.effort,
            timeout_sec=args.timeout,
        )
        print(json.dumps(result.to_dict(), indent=2, ensure_ascii=False))
        return 0 if result.status in ("success", "partial_success") else 1
    except Exception as e:
        print(f"Error during invocation: {e}", file=sys.stderr)
        return 1


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="agentctl",
        description="Agent Executor Gateway Control CLI",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # 1. agentctl task ...
    task_parser = subparsers.add_parser("task", help="Task management, routing, DAG, and verification commands")
    task_subparsers = task_parser.add_subparsers(dest="task_subcommand", required=True)

    # agentctl task validate TASK.json
    val_parser = task_subparsers.add_parser("validate", help="Validate a Task JSON specification file")
    val_parser.add_argument("task_file", help="Path to Task JSON file")
    val_parser.add_argument("--json", action="store_true", help="Output validated Task as JSON")

    # agentctl task verify TASK.json
    ver_parser = task_subparsers.add_parser("verify", help="Run verification commands and scope checking for a Task")
    ver_parser.add_argument("task_file", help="Path to Task JSON file")
    ver_parser.add_argument("--repo", default=None, help="Override repository working directory")
    ver_parser.add_argument("--log-dir", default=None, help="Directory to store verification logs")
    ver_parser.add_argument("--metrics-file", default=None, help="Path to metrics.jsonl file")
    ver_parser.add_argument("--session-id", default=None, help="Execution session identifier for report")
    ver_parser.add_argument("--timeout", type=float, default=120.0, help="Per-command execution timeout in seconds")
    ver_parser.add_argument("--skip-scope", action="store_true", help="Skip Git scope boundary checking")
    ver_parser.add_argument("--json", action="store_true", help="Output Completion Report as JSON")

    # agentctl task route TASK.json
    route_parser = task_subparsers.add_parser("route", help="Evaluate rule-based executor routing for a Task")
    route_parser.add_argument("task_file", help="Path to Task JSON file")
    route_parser.add_argument("--override", "-o", default=None, choices=["agy", "grok"], help="Explicit executor override")
    route_parser.add_argument("--json", action="store_true", help="Output routing decision as JSON")

    # agentctl task plan TASK.json
    plan_parser = task_subparsers.add_parser("plan", help="Display execution and escalation plan for a Task")
    plan_parser.add_argument("task_file", help="Path to Task JSON file")
    plan_parser.add_argument("--override", "-o", default=None, choices=["agy", "grok"], help="Explicit executor override")
    plan_parser.add_argument("--json", action="store_true", help="Output plan as JSON")

    # agentctl task ready TASK1.json [TASK2.json ...]
    ready_parser = task_subparsers.add_parser("ready", help="List tasks currently ready for parallel execution")
    ready_parser.add_argument("task_files", nargs="+", help="Task JSON file(s) or directories")
    ready_parser.add_argument("--json", action="store_true", help="Output ready task IDs as JSON")

    # agentctl task graph TASK1.json [TASK2.json ...]
    graph_parser = task_subparsers.add_parser("graph", help="Display DAG dependency graph")
    graph_parser.add_argument("task_files", nargs="+", help="Task JSON file(s) or directories")
    graph_parser.add_argument("--json", action="store_true", help="Output DAG structure as JSON")

    # agentctl task run TASK.json (Explicitly reject in Phase 8/future)
    run_parser = task_subparsers.add_parser("run", help="Run task execution (Phase 9+)")
    run_parser.add_argument("task_file", help="Path to Task JSON file")

    # 2. agentctl worktree ...
    wt_parser = subparsers.add_parser("worktree", help="Worktree management commands")
    wt_subparsers = wt_parser.add_subparsers(dest="worktree_subcommand", required=True)

    # agentctl worktree create TASK.json
    wt_create = wt_subparsers.add_parser("create", help="Create an isolated worktree for a Task")
    wt_create.add_argument("task_file", help="Path to Task JSON file")
    wt_create.add_argument("--executor", default=None, choices=["agy", "grok"], help="Executor name override")
    wt_create.add_argument("--root", default=None, help="Root directory for worktrees")
    wt_create.add_argument("--json", action="store_true", help="Output as JSON")

    # agentctl worktree list
    wt_list = wt_subparsers.add_parser("list", help="List active worktrees")
    wt_list.add_argument("--repo", default=None, help="Repository root directory")
    wt_list.add_argument("--root", default=None, help="Worktree root directory")
    wt_list.add_argument("--json", action="store_true", help="Output as JSON")

    # agentctl worktree cleanup <target>
    wt_clean = wt_subparsers.add_parser("cleanup", help="Safely clean up a worktree")
    wt_clean.add_argument("target", help="Task ID or worktree directory path")
    wt_clean.add_argument("--repo", default=None, help="Repository root directory")
    wt_clean.add_argument("--root", default=None, help="Worktree root directory")
    wt_clean.add_argument("--force", "-f", action="store_true", default=True, help="Force remove worktree")

    # 3. agentctl executors
    exc_parser = subparsers.add_parser("executors", help="List registered executors and their capabilities")
    exc_parser.add_argument("--json", action="store_true", help="Output as JSON")

    # 4. agentctl health
    hlt_parser = subparsers.add_parser("health", help="Probe gateway and executor health")

    # 5. agentctl invoke <executor> --prompt ... --cwd ...
    inv_parser = subparsers.add_parser("invoke", help="Invoke an executor with prompt")
    inv_parser.add_argument("executor", choices=["agy", "grok"], help="Executor name")
    inv_parser.add_argument("--prompt", "-p", required=True, help="Task instruction prompt")
    inv_parser.add_argument("--cwd", default=None, help="Working directory for executor")
    inv_parser.add_argument("--session-id", "-s", default=None, help="Existing session ID to resume")
    inv_parser.add_argument("--model", "-m", default=None, help="Model override")
    inv_parser.add_argument("--effort", "-e", default=None, help="Reasoning effort override")
    inv_parser.add_argument("--timeout", "-t", type=int, default=None, help="Execution timeout in seconds")

    parsed = parser.parse_args()

    if parsed.command == "task":
        if parsed.task_subcommand == "validate":
            return cmd_task_validate(parsed)
        elif parsed.task_subcommand == "verify":
            return cmd_task_verify(parsed)
        elif parsed.task_subcommand == "route":
            return cmd_task_route(parsed)
        elif parsed.task_subcommand == "plan":
            return cmd_task_plan(parsed)
        elif parsed.task_subcommand == "ready":
            return cmd_task_ready(parsed)
        elif parsed.task_subcommand == "graph":
            return cmd_task_graph(parsed)
        elif parsed.task_subcommand == "run":
            print(
                "Error: 'agentctl task run' is not implemented in Phase 8 (autonomous DAG execution is deferred per Goal Prompt).",
                file=sys.stderr,
            )
            return 1
    elif parsed.command == "worktree":
        if parsed.worktree_subcommand == "create":
            return cmd_worktree_create(parsed)
