#!/usr/bin/env python3
"""
ACP CLI Client with Explicit Non-Zero Exit Codes on Failure
"""

import sys
import os
import json
import urllib.request
import urllib.error

TOKEN_FILE = "/home/codex/.codex/acp_token"
SERVER_URL = os.environ.get("ACP_SERVER_URL", "http://127.0.0.1:8765")

def get_token():
    if os.path.exists(TOKEN_FILE):
        with open(TOKEN_FILE, "r") as f:
            return f.read().strip()
    return ""

def make_request(path, data=None, token=None):
    url = f"{SERVER_URL.rstrip('/')}{path}"
    headers = {'Content-Type': 'application/json; charset=utf-8'}
    if token:
        headers['Authorization'] = f"Bearer {token}"

    body = json.dumps(data, ensure_ascii=False).encode('utf-8') if data is not None else None
    req = urllib.request.Request(url, data=body, headers=headers, method='POST' if data is not None else 'GET')

    try:
        with urllib.request.urlopen(req, timeout=65) as response:
            res_body = response.read().decode('utf-8')
            parsed = json.loads(res_body)
            # If server returned json with status: error, exit non-zero
            if parsed.get('status') == 'error':
                return parsed, 1
            return parsed, 0
    except urllib.error.HTTPError as e:
        err_body = e.read().decode('utf-8')
        try:
            parsed = json.loads(err_body)
        except:
            parsed = {'error': f'HTTP Error {e.code}: {e.reason}'}
        return parsed, (e.code if e.code != 200 else 1)
    except Exception as e:
        return {'error': f'Connection failed: {str(e)}'}, 2

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ['-h', '--help', 'help']:
        print("Usage: acp-cli <status|invoke|send|metadata> [args...]")
        print("Examples:")
        print("  acp-cli status")
        print("  acp-cli invoke \"分析代码: /workspace/processor.py\"")
        print("  acp-cli send <conversation_id> \"继续处理\"")
        sys.exit(0)

    action = sys.argv[1].lower()
    token = get_token()

    if action == 'status':
        res, code = make_request('/acp/v1/status')
        print(json.dumps(res, indent=2, ensure_ascii=False))
        sys.exit(code if code == 0 else 1)

    elif action in ['invoke', 'new']:
        if len(sys.argv) < 3:
            print("Error: Prompt text required")
            sys.exit(1)
        prompt = " ".join(sys.argv[2:])
        res, code = make_request('/acp/v1/invoke', {'prompt': prompt}, token=token)
        print(json.dumps(res, indent=2, ensure_ascii=False))
        sys.exit(code if code == 0 else 1)

    elif action == 'send':
        if len(sys.argv) < 4:
            print("Error: Usage: acp-cli send <recipient_id> <content>")
            sys.exit(1)
        recipient_id = sys.argv[2]
        content = " ".join(sys.argv[3:])
        res, code = make_request('/acp/v1/send-message', {'recipient_id': recipient_id, 'content': content}, token=token)
        print(json.dumps(res, indent=2, ensure_ascii=False))
        sys.exit(code if code == 0 else 1)

    elif action == 'metadata':
        if len(sys.argv) < 3:
            print("Error: Usage: acp-cli metadata <conversation_id>")
            sys.exit(1)
        cid = sys.argv[2]
        res, code = make_request('/acp/v1/metadata', {'conversation_id': cid}, token=token)
        print(json.dumps(res, indent=2, ensure_ascii=False))
        sys.exit(code if code == 0 else 1)

    else:
        print(f"Unknown action: {action}")
        sys.exit(1)

if __name__ == '__main__':
    main()
